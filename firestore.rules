rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Painel privado: somente este UID do Firebase Authentication pode acessar dados.
    function isAuthorizedUser() {
      return request.auth != null
             && request.auth.uid == 'V8uLmGwlxUVnHUjr5IDm5wjEp542'
             && request.auth.token.firebase.sign_in_provider == 'password';
    }

    match /users/{userId}/{document=**} {
      allow read, write: if isAuthorizedUser()
                         && userId == request.auth.uid;
    }

    // Qualquer outro caminho do Firestore permanece bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
